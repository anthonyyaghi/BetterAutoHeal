# BetterAutoHeal configuration. Copy to `.env` next to docker-compose.yml
# and fill in real values. Docker Compose auto-loads `.env`.
#
#   cp .env.example .env
#   # edit .env, then:
#   ./install.sh

# --- Required when BAH_NOTIFY=true ---
# Slack Incoming Webhook URL. Create one at:
#   https://api.slack.com/apps  →  Incoming Webhooks
BAH_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK

# --- Optional (shown with defaults) ---

# Poll interval (Go duration: 1s, 500ms, 2m, ...)
BAH_INTERVAL=5s

# Grace period after a container starts before it can be revived.
BAH_START_PERIOD=0s

# Seconds passed to `docker restart` / `docker compose stop`.
BAH_STOP_TIMEOUT=10

# Global default revive mode when a container has no betterautoheal.mode label.
# One of: restart, compose
BAH_DEFAULT_MODE=restart

# Docker label filter used to discover monitored containers.
BAH_LABEL_FILTER=betterautoheal.enable=true

# Lines of container logs to capture before revival.
BAH_LOG_LINES=100

# Master switch for Slack notifications.
BAH_NOTIFY=true

# Display name used in Slack.
BAH_SLACK_USERNAME=BetterAutoHeal

# Minimum gap between detection notifications for the same container (anti-spam).
BAH_NOTIFY_COOLDOWN=30s

# Log level: debug, info, warn, error
BAH_LOG_LEVEL=info

# Friendly name for this deployment, prefixed onto every Slack message
# header (e.g. "[Home Server] Unhealthy: homeassistant"). Leave blank to
# omit. install.sh will prompt for this when run interactively.
BAH_PROJECT_NAME=

# --- Restart-loop detection ---
# Watches the Docker RestartCount on each opted-in container. If it
# grows by BAH_LOOP_THRESHOLD within BAH_LOOP_WINDOW, BAH logs a warning,
# sends a Slack message with a log tail, and (by default) recreates
# the container via `docker compose up -d --force-recreate --no-deps`.
# Override per-container with betterautoheal.loop_action=recreate|stop|notify|ignore.
BAH_LOOP_DETECTION=true
BAH_LOOP_THRESHOLD=3
BAH_LOOP_WINDOW=2m
BAH_LOOP_COOLDOWN=15m
